{
  "name": "@mirrowel/opencode-agent-variants",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode plugin for creating and managing model variants of agents",
  "license": "MIT",
  "author": "Mirrowel",
  "homepage": "https://github.com/Mirrowel/opencode-agent-variants#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mirrowel/opencode-agent-variants.git"
  },
  "bugs": {
    "url": "https://github.com/Mirrowel/opencode-agent-variants/issues"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./src/tui.tsx"
    }
  },
  "files": [
    "dist",
    "src",
    "docs/CONFIG.md",
    "agent-variants.example.jsonc",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent",
    "subagent",
    "model",
    "variants"
  ],
  "oc-plugin": [
    "server",
    "tui"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc --outDir dist --declaration",
    "ci": "npm run release:intent:check && npm run typecheck && npm run build && npm pack --dry-run",
    "commit:check": "npm run ci",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "release:intent": "node scripts/set-release-intent.mjs",
    "release:intent:check": "node scripts/check-release-intent.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": ">=1.14.0",
    "@opentui/solid": "^0.2.16",
    "comment-json": "^4.2.5",
    "solid-js": "1.9.12",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.0"
  },
  "directories": {
    "doc": "docs"
  }
}
